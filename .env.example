# Copy this file to .env and fill it in. Never commit .env.

# --- Meta / Instagram (Instagram API with Instagram Login) ---
# App Dashboard → Instagram → API setup with Instagram login
IG_APP_SECRET=
# Optional: Facebook app secret (App settings -> Basic). Meta may sign webhooks with this one instead.
META_APP_SECRET=
# Long-lived Instagram User access token for @triangleresells
IG_ACCESS_TOKEN=
# Any random string you make up. Paste the same value into the webhook settings in the Meta dashboard.
IG_VERIFY_TOKEN=
# Graph API version for graph.instagram.com
IG_API_VERSION=v23.0

# --- Claude ---
ANTHROPIC_API_KEY=
# Sonnet makes far fewer mistakes with prices, holds and order details than Haiku (see the retest). ~5-6 cents a chat.
CLAUDE_MODEL=claude-sonnet-5-5

# Master switch: the bot only sends DMs when this is true.
BOT_ENABLED=false
# true = the bot reads DMs and drafts replies on /admin/shadow, but sends nothing and books nothing (works with BOT_ENABLED=false)
SHADOW_MODE=false

# --- Business ---
ACCOUNT_NAME=Triangle Resells
VENDOR_SITE_URL=triangleresells.com
# --- Stock and prices: the warehouse sheet (BOT STOCK + BOT PRICES tabs) ---
# The whole Google service account key file, pasted as-is (JSON). Share BOTH sheets (warehouse + sales tracker) with its client_email as EDITOR: the bot takes sold pieces off BOT STOCK and logs sales.
# NEVER publish the sheet to the web and never commit the key file. Blank = the bot uses the saved snapshot in config/.
GOOGLE_SERVICE_ACCOUNT_JSON=
WAREHOUSE_SHEET_ID=1hZQltkbmqhN4acr959K7cNxUcvLW-P38Ut60O805wOw
# A buyer who got a price and went quiet gets ONE nudge after this many minutes. 0 = off.
QUIET_NUDGE_MINUTES=90
# Wait ~42-58s before answering a cold DM (8-18s mid-conversation). false = answer after 4s.
HUMAN_REPLY_DELAY=true

# Free gifts from FREEBIE rows on the sheet. Off (false) = ignored everywhere, whatever the sheet says.
FREEBIES_ENABLED=false

# --- Handoff alerts ---
# Optional: Discord or Slack incoming webhook URL. Team gets pinged here on every handoff.
HANDOFF_WEBHOOK_URL=
# How long the bot stays quiet in a chat after a handoff or after a team member replies
# Set either one. Minutes wins if both are set.
HUMAN_PAUSE_MINUTES=720
HUMAN_PAUSE_HOURS=12
# While the team has a chat, if a buyer's message gets no reply from the team for this many minutes, the bot takes over again. 0 = never.
TAKEOVER_MINUTES=5

# --- Payments ---
# Right now buyers pay cash (pickup only), Cash App or Zelle: the bot locks in the order and sends the pay info.
# Stripe links only come back when STRIPE_ENABLED=true AND a key is set.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook pointed at https://YOUR-URL/stripe/webhook (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=
# Where buyers land after paying
CHECKOUT_SUCCESS_URL=https://triangleresells.com
# Sent to buyers only after they pay for a pickup. Street address only, NO unit number: every pickup is in the parking lot.
WAREHOUSE_ADDRESS=

# --- Google Calendar ---
# Web app URL of scripts/google-calendar.gs. Each paid order becomes an event on its pickup/ship day.
CALENDAR_WEBHOOK_URL=

# --- Small database + customer list ---
# File where chats, follow-ups and the customer list are saved. On Render: /var/data/bot-state.json (see render.yaml).
STATE_FILE=./data/bot-state.json
# Password for the customer list page at https://YOUR-URL/admin?key=THIS. Make up a long random one.
ADMIN_KEY=

PORT=3000

# --- Triangle CRM (crm/ on Netlify) ---
# Every locked-in order also becomes a CRM booking. Blank = off.
CRM_API_URL=
# Long random key; the same value goes in the CRM site's CRM_BOT_API_KEY on Netlify.
CRM_BOT_API_KEY=
# Who bot bookings are assigned to: Josh, Chema or Diego.
CRM_ASSIGNEE=Chema
# Team assistant (the chat inside the CRM) runs on this bot. All three set = on.
# Supabase project URL and its PUBLIC (anon / publishable) key: the assistant acts as whoever is logged in to the CRM.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# The CRM's web address (only that site may use the assistant), e.g. https://triangle-crm.netlify.app
CRM_WEB_ORIGIN=

# Sales tracker spreadsheet (paid bot orders get logged here). Share it with the service account as Editor.
TRACKER_SHEET_ID=1ks_DjoGUucVHgzf7mhx9P1B1HTySaNxWbGGsteQ1eGI
# Sent to Zelle / Cash App buyers once an order is locked in. Blank = Josh sends it himself.
PAY_ZELLE=919-480-7349
PAY_CASHAPP=$triangleresells
