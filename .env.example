# Copy this file to .env and fill it in. Never commit .env.

# --- Meta / Instagram (Instagram API with Instagram Login) ---
# App Dashboard → Instagram → API setup with Instagram login
IG_APP_SECRET=
# Long-lived Instagram User access token for @triangleresells
IG_ACCESS_TOKEN=
# Any random string you make up. Paste the same value into the webhook settings in the Meta dashboard.
IG_VERIFY_TOKEN=
# Graph API version for graph.instagram.com
IG_API_VERSION=v23.0

# --- Claude ---
ANTHROPIC_API_KEY=
# Fast and cheap for DMs. Switch to claude-sonnet-5-5 if replies need to be smarter.
CLAUDE_MODEL=claude-haiku-5-5

# --- Business ---
ACCOUNT_NAME=Triangle Resells
VENDOR_SITE_URL=triangleresells.netlify.app
# Optional: Google Sheet published as CSV (File → Share → Publish to web → CSV).
# Live prices, stock and restock dates. Leave blank to use only config/knowledge-base.md.
INVENTORY_SHEET_CSV_URL=

# --- Handoff alerts ---
# Optional: Discord or Slack incoming webhook URL. Team gets pinged here on every handoff.
HANDOFF_WEBHOOK_URL=
# How long the bot stays quiet in a chat after a handoff or after a team member replies
HUMAN_PAUSE_HOURS=12

PORT=3000
