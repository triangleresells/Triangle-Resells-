# Copy this file to .env and fill it in. Never commit .env.

# --- Meta / Instagram (Instagram API with Instagram Login) ---
# App Dashboard → Instagram → API setup with Instagram login
IG_APP_SECRET=
# Optional: Facebook app secret (App settings -> Basic). Meta may sign webhooks with this one instead.
META_APP_SECRET=
# Long-lived Instagram User access token for @triangleresells
IG_ACCESS_TOKEN=
# Any random string you make up. Paste the same value into the webhook settings in the Meta dashboard.
IG_VERIFY_TOKEN=
# Graph API version for graph.instagram.com
IG_API_VERSION=v23.0

# --- Claude ---
ANTHROPIC_API_KEY=
# Fast and cheap for DMs. Switch to claude-sonnet-5-5 if replies need to be smarter.
CLAUDE_MODEL=claude-haiku-5-5

# --- Business ---
ACCOUNT_NAME=Triangle Resells
VENDOR_SITE_URL=triangleresells.com
# Optional: Google Sheet published as CSV (File → Share → Publish to web → CSV).
# Live prices, stock and restock dates. Leave blank to use only config/knowledge-base.md.
INVENTORY_SHEET_CSV_URL=

# --- Handoff alerts ---
# Optional: Discord or Slack incoming webhook URL. Team gets pinged here on every handoff.
HANDOFF_WEBHOOK_URL=
# How long the bot stays quiet in a chat after a handoff or after a team member replies
# Set either one. Minutes wins if both are set.
HUMAN_PAUSE_MINUTES=5
HUMAN_PAUSE_HOURS=12

# --- Payments (Stripe) ---
# Restricted key with write access to Checkout Sessions. Without it the bot quotes and hands off to take payment.
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook pointed at https://YOUR-URL/stripe/webhook (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=
# Where buyers land after paying
CHECKOUT_SUCCESS_URL=https://triangleresells.com
# Sent to buyers only after they pay for a pickup. Street address only, NO unit number: every pickup is in the parking lot.
WAREHOUSE_ADDRESS=

# --- Google Calendar ---
# Web app URL of scripts/google-calendar.gs. Each paid order becomes an event on its pickup/ship day.
CALENDAR_WEBHOOK_URL=

# --- Small database + customer list ---
# File where chats, follow-ups and the customer list are saved. On Render: /var/data/bot-state.json (see render.yaml).
STATE_FILE=./data/bot-state.json
# Password for the customer list page at https://YOUR-URL/admin?key=THIS. Make up a long random one.
ADMIN_KEY=

PORT=3000
